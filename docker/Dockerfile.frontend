# ============================================================
# Dockerfile del frontend (SecureDevOps.Web SPA) — versión SEGURA
# Build context: RAIZ DEL REPO (necesario para docker/nginx.conf).
#  - Multi-stage: node → nginx (no-root: nginxinc/nginx-unprivileged)
#  - Build con VITE_API_URL como build-arg (sin secretos)
#  - La SPA se sirve con headers de seguridad y proxy /api → backend
# ============================================================

# ---- Stage 1: build del bundle ----
FROM node:22-alpine AS build
WORKDIR /app

COPY SecureDevOps.Web/package.json SecureDevOps.Web/package-lock.json* ./
RUN npm ci

COPY SecureDevOps.Web/ ./
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ---- Stage 2: nginx (usuario no-root) ----
FROM nginxinc/nginx-unprivileged:1.27-alpine AS final

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]