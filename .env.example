# ============================================================
# SecureDevOpsPlayground — variables de entorno (EJEMPLO)
# Copia este archivo a `.env` (NO commit-ead) o exporta las
# variables en tu entorno / secret manager / pipeline.
#
# ⚠️ JAMÁS pongas aquí valores reales. Usa los placeholders.
# ============================================================

# ---------- Backend (SecureDevOps.API) ----------
# JWT: si no se define, se usa el valor por defecto de appsettings.json
# (NO recomendado en producción). En producción SIEMPRE define esta variable.
JWT_SECRET=change-me-a-secure-random-32+characters-minimum!!

# Conexión SQLite (por defecto usa SecureDevOpsDb.db local)
CONNECTIONSTRINGS__DEFAULTCONNECTION=Data Source=SecureDevOpsDb.db

# Habilitar endpoints de laboratorio (Snyk DAST). false en producción.
SECURITYLAB__ENABLED=false

# CORS: origenes permitidos separados por comas (opcional)
# CORS__ALLOWEDORIGINS=http://localhost:3000

# Puerto HTTP (Render/Heroku) — opcional
# PORT=8080

# ---------- Frontend (SecureDevOps.Web) ----------
# URL pública de la API. En dev con proxy no hace falta.
# VITE_API_URL=https://tu-backend.example.com

# ---------- Snyk API scripts (snyk-api/) ----------
# Token de Snyk para los scripts (NUNCA hardcodearlo)
SNYK_TOKEN=
# ID de la organización/workspace de Snyk (opcional para algunos scripts)
SNYK_ORG=

# ---------- CI/CD ----------
# En GitHub Actions se usan los repository secrets (Settings → Secrets)
#   SNYK_TOKEN    → token Snyk
#  Ver .github/workflows/ci.yml